# Production secrets template — copy to .env.production and fill values.
# NEVER commit .env.production. Add it to .gitignore (already covered by .env*).
#
# Generation hints:
#   openssl rand -hex 32   → JWT_SECRET / API_KEY (strong random 64-char hex)
#   pwgen 24 1             → POSTGRES_PASSWORD / MINIO_ROOT_PASSWORD / ADMIN_PASSWORD
#   阿里云 RAM 子账号       → ALIYUN_ACCESS_KEY_ID / ALIYUN_ACCESS_KEY_SECRET
#                            (复用 dev: livestream-analyzer-kdz + LivestreamAnalyzerPolicy)

# ---- Postgres ----
POSTGRES_USER=livepulse_prod
POSTGRES_PASSWORD=CHANGEME_strong_random_24chars
POSTGRES_DB=livepulse

# ---- MinIO ----
MINIO_ROOT_USER=livepulse_minio
MINIO_ROOT_PASSWORD=CHANGEME_strong_random_24chars
MINIO_BUCKET=livestream-videos

# ---- Application secrets ----
# X-API-Key for legacy admin operations. Bypass is DISABLED in prod (see
# ALLOW_ADMIN_API_KEY=false in docker-compose.prod.yml), but the value is
# still required for some test harnesses.
API_KEY=CHANGEME_openssl_rand_hex_32
# JWT signing secret. Min 32 chars. Rotating this invalidates all
# active sessions — do it during a planned maintenance window.
JWT_SECRET=CHANGEME_openssl_rand_hex_32
# Seed admin user on first startup. After first boot, change password via
# /auth/change-password (M2 feature) and clear these to skip re-seeding.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGEME_strong_password

# ---- 阿里云 OCR / ASR ----
# Reuse dev sub-account "livestream-analyzer-kdz" + LivestreamAnalyzerPolicy.
# See reference_aliyun_setup memory for IAM setup.
ALIYUN_ACCESS_KEY_ID=LTAI_xxxxxxxxxxxxx
ALIYUN_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ASR appkey if using NLS streaming ASR; empty → fall back to local whisper.
ALIYUN_ASR_APPKEY=
# 🔴 MUST be false in production. config.py defaults aliyun_frozen=True
# (a leftover billing-suspension safeguard); leaving it unset makes every
# OCR/ASR call raise "已冻结" and the whole pipeline fails. See audit P1-2.
ALIYUN_FROZEN=false

# ---- LLM providers ----
# Set at least one; the AI Range Analysis endpoint 503s with a clear
# message if both are empty.
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxx

# ---- Observability ----
# Get DSN from https://sentry.io → Create Project → Browser/Node SDK key.
# Empty = Sentry init is a no-op (errors only go to stdout).
SENTRY_DSN=

# ---- CORS / domain ----
# Strict allow-list. Comma-separated. NO trailing slash, NO wildcard in prod.
CORS_ALLOW_ORIGINS=https://your-domain.com

# ---- Rate limiting ----
# Per-IP limit on /auth/register + /auth/login. Tighten on production.
AUTH_RATE_LIMIT=5/minute

# ---- Celery worker tuning ----
# Concurrency = number of pipeline tasks that can run simultaneously per
# worker container. Each task loads whisper + sentence-transformers
# ≈ 2 GB RAM, so 2c4g ECS caps out at 2.
WORKER_CONCURRENCY=2
